#!/usr/bin/env bash
# The one gate (TC-5): every check, judged by its own exit status, stopping at the first failure
# (SH-11). CI runs exactly this. Outside the dev container it re-runs itself inside one.
set -euo pipefail
IFS=$'\n\t'

cd "$(dirname "$0")"
if [[ "${JACKSTAY_DEV_CONTAINER:-}" != 1 ]]; then
  exec ./dev ./check "$@"
fi
# Build artifacts belong to the tree being checked. Cargo names a workspace member's artifacts by
# its path relative to the workspace root, so two copies of the tree sharing a target directory
# share artifacts, and cargo's mtime freshness can then run a binary built from the other copy.
export CARGO_TARGET_DIR="$PWD/.cache/target"

step() {
  printf '\n== %s\n' "$1"
  shift
  "$@"
}

# [workspace.lints] reaches only members that opt in, so a member without the opt-in would silently
# lose `forbid(unsafe_code)` and every other workspace lint.
workspace_lints_opt_in() {
  local manifest missing=0
  for manifest in crates/*/Cargo.toml; do
    if ! awk '/^\[lints\]$/ { in_lints = 1; next } /^\[/ { in_lints = 0 }
              in_lints && /^workspace = true$/ { found = 1 } END { exit !found }' "$manifest"; then
      printf '%s: missing "[lints] workspace = true"\n' "$manifest"
      missing=1
    fi
  done
  return "$missing"
}

# cargo-deny 0.20.2 leaves dev-dependencies from outside the workspace out of the graph its
# license check reads (`ignore_kind(DepKind::Dev, Scope::NonWorkspace)` in its common.rs), and
# reports "licenses ok" for a dev-dependency under a license deny.toml does not allow. Its advisory
# check does see them. So it runs on a mirror of the manifests in which dev-dependencies are
# ordinary dependencies, and the gate fails unless that graph is the whole build graph (TS-6).
deny_whole_graph() {
  local mirror=.cache/deny-graph manifest
  rm -rf "$mirror"
  mkdir -p "$mirror"
  git ls-files -z -- Cargo.toml Cargo.lock deny.toml crates | xargs -0 cp --parents -t "$mirror"
  for manifest in "$mirror"/crates/*/Cargo.toml; do
    sed -i 's/^\[dev-dependencies\]$/[target.'"'"'cfg(all())'"'"'.dependencies]/' "$manifest"
  done
  # Every package cargo would build for our target, against every package cargo-deny examined.
  local expected seen
  expected=$(cargo tree --workspace --locked --target x86_64-unknown-linux-gnu \
      --edges normal,build,dev --prefix none --format '{p}' \
    | grep -v '^$' | sed -E 's/^([^ ]+) v([^ ]+).*/\1@\2/' | sort -u)
  seen=$(cargo deny --manifest-path "$mirror/Cargo.toml" --locked list --format human \
    | sed -E 's/^[^:]*: //' | tr ',' '\n' | sed -E 's/^ +//' | grep -v '^$' | sort -u)
  if [[ "$seen" != "$expected" ]]; then
    printf 'cargo-deny graph differs from the build graph:\n'
    diff <(printf '%s\n' "$expected") <(printf '%s\n' "$seen") || true
    return 1
  fi
  printf 'cargo-deny graph covers all %s packages of the build graph\n' "$(wc -l <<<"$expected")"
  cargo deny --manifest-path "$mirror/Cargo.toml" --config deny.toml --locked check
}

# CD-7: no hidden characters in tracked text. NUL and the other C0 controls but tab, newline and
# carriage return; DEL; and the Unicode bidirectional and zero-width characters that make source
# read differently from how it compiles. Escapes (`\0`, `\u{200b}`) are the way to write them.
# The scan reads bytes and matches those characters' UTF-8 encodings, so a file that is not valid
# UTF-8 cannot stop it partway (a decoding perl dies on one, and its END block hid the death).
hidden_characters() {
  git ls-files -z -- ':!*.png' ':!crates/*/fuzz/corpus/*' \
    | xargs -0 -r perl -ne '
        if (/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]|\xE2\x80[\x8B-\x8F\xAA-\xAE]|\xE2\x81[\xA0-\xA4\xA6-\xA9]|\xEF\xBB\xBF/) {
          printf "%s:%d: hidden character\n", $ARGV, $.;
          $bad = 1;
        }
        close ARGV if eof;
        END { $? ||= $bad ? 1 : 0 }'
}

# Every decoder crate's fuzz targets: a separate package each, with its own lockfile.
shopt -s nullglob
fuzz=(crates/*/fuzz/Cargo.toml)
shopt -u nullglob
(( ${#fuzz[@]} > 0 )) || { printf 'no fuzz crates found\n'; exit 2; }
step "workspace lints reach every crate" workspace_lints_opt_in
step "hidden characters" hidden_characters
step "format" cargo fmt --all --check
for f in "${fuzz[@]}"; do
  step "format (fuzz targets, ${f%/Cargo.toml})" cargo fmt --manifest-path "$f" --check
done
step "clippy" cargo clippy --workspace --all-targets --locked -- -D warnings
step "tests" cargo test --workspace --locked
step "dependencies (cargo-deny, whole graph)" deny_whole_graph
for f in "${fuzz[@]}"; do
  step "fuzz targets build (${f%/Cargo.toml})" cargo check --manifest-path "$f" --locked
  step "dependencies (cargo-deny, fuzz targets, ${f%/Cargo.toml})" \
    cargo deny --manifest-path "$f" --config deny.toml --locked check
done
printf '\n== all checks passed\n'
