#!/usr/bin/env bash
# Runs tools/install against a home of its own and checks what it wrote, what --replace-clipman
# changed and what --uninstall removed. Only in the dev container: --replace-clipman stops this
# user's xfce4-clipman, and here the only one is the stand-in started below.
set -euo pipefail
IFS=$'\n\t'

cd "$(dirname "$0")/.."
if [[ "${JACKSTAY_DEV_CONTAINER:-}" != 1 ]]; then
  printf 'run in the dev container: ./dev tools/test-install\n' >&2
  exit 2
fi
built=${CARGO_TARGET_DIR:-$PWD/target}/debug
home=$PWD/.cache/install-test
rm -rf "$home"
mkdir -p "$home"

fail() {
  printf 'install test: %s\n' "$*" >&2
  exit 1
}
# xfconf, standing in: properties kept one a line ("path value") in a file.
fakes=$home/fakes
mkdir -p "$fakes"
xfconf=$home/xfconf
: >"$xfconf"
{
  printf '#!/bin/bash\nstore=%q\n' "$xfconf"
  cat <<'FAKE'
p="" v="" list=0 remove=0
while (($#)); do
  case "$1" in
    -c | -t) shift ;;
    -p) p=$2; shift ;;
    -s) v=$2; shift ;;
    -l) list=1 ;;
    -r) remove=1 ;;
  esac
  shift
done
if ((list)); then grep -F "$p/" "$store" || true
elif ((remove)); then grep -vF "$p " "$store" >"$store.new" || true; mv "$store.new" "$store"
else printf '%s %s\n' "$p" "$v" >>"$store"; fi
FAKE
} >"$fakes/xfconf-query"
chmod +x "$fakes/xfconf-query"

install() {
  HOME=$home XDG_CONFIG_HOME="" XDG_DATA_HOME="" PATH="$fakes:$PATH" tools/install --from "$built" "$@"
}

# A session file of the user's own, kept around Jackstay's block.
printf 'export LANG=en_CA.UTF-8\n' >"$home/.xsessionrc"
chmod 600 "$home/.xsessionrc"
install
for p in jackstayd jackstay jackstay-ui jackstay-session; do
  [[ -x "$home/.local/bin/$p" ]] || fail "$p not installed"
done
cmp -s "$built/jackstayd" "$home/.local/bin/jackstayd" || fail "jackstayd is not the built one"
for unit in jackstayd.service jackstay-ui.service; do
  cmp -s "data/systemd/$unit" "$home/.config/systemd/user/$unit" || fail "$unit differs"
done
for icon in jackstay.svg jackstay-symbolic.svg; do
  cmp -s "data/icons/$icon" "$home/.local/share/icons/hicolor/scalable/apps/$icon" \
    || fail "$icon not installed"
done
grep -qx "Exec=$home/.local/bin/jackstay-session" "$home/.config/autostart/jackstay.desktop" \
  || fail "autostart entry does not run the installed jackstay-session"
[[ "$(stat -c %a "$home/.config/autostart/jackstay.desktop")" == 644 ]] || fail "entry mode"
grep -qx 'export LANG=en_CA.UTF-8' "$home/.xsessionrc" || fail "the user's .xsessionrc lost"
grep -qx 'export XFSETTINGSD_NO_CLIPBOARD=1' "$home/.xsessionrc" || fail "xfsettingsd's switch unset"
[[ "$(stat -c %a "$home/.xsessionrc")" == 600 ]] || fail ".xsessionrc mode changed"
install # again, over the first
[[ "$(grep -c XFSETTINGSD_NO_CLIPBOARD "$home/.xsessionrc")" == 1 ]] || fail "switch set twice"
sh -n "$home/.xsessionrc" || fail ".xsessionrc is not valid sh"
[[ "$(env -i sh -c ". '$home/.xsessionrc'; echo \$XFSETTINGSD_NO_CLIPBOARD")" == 1 ]] \
  || fail ".xsessionrc does not export the switch"

# Starting at login turned off stays off through an upgrade, and on stays on.
sed -i '/^\[Desktop Entry\]$/a Hidden=true' "$home/.config/autostart/jackstay.desktop"
install >/dev/null
grep -qx 'Hidden=true' "$home/.config/autostart/jackstay.desktop" || fail "login turned back on"
[[ "$(grep -c '^Hidden' "$home/.config/autostart/jackstay.desktop")" == 1 ]] || fail "Hidden twice"
sed -i '/^Hidden=/d' "$home/.config/autostart/jackstay.desktop"
install >/dev/null
! grep -q '^Hidden' "$home/.config/autostart/jackstay.desktop" || fail "login turned off"
[[ -z "$(find "$home" -name '*.tmp-*')" ]] || fail "temporary files left"

entry=$home/.config/autostart/xfce4-clipman-plugin-autostart.desktop
printf '[Desktop Entry]\nName=Clipman\nExec=xfce4-clipman\nHidden=false\n' >"$entry"
# A script's process is named after the script. (/bin/sleep, copied, refuses another name.)
# shellcheck disable=SC2016 # the stand-in's own code
printf '#!/bin/sh\ntrap '"'"'kill $! 2>/dev/null; exit 0'"'"' TERM\nsleep 60 &\nwait\n' \
  >"$home/xfce4-clipman"
chmod +x "$home/xfce4-clipman"
"$home/xfce4-clipman" &
clipman=$!
sleep 0.2
[[ "$(cat "/proc/$clipman/comm")" == xfce4-clipman ]] || fail "the stand-in is misnamed"
install --replace-clipman >/dev/null
grep -qx 'Hidden=true' "$entry" || fail "clipman's autostart still on"
! grep -qx 'Hidden=false' "$entry" || fail "clipman's entry has both"
! kill -0 "$clipman" 2>/dev/null || fail "clipman not stopped"
# An entry without the key gets one.
printf '[Desktop Entry]\nName=Clipman\nExec=xfce4-clipman\n' >"$entry"
install --replace-clipman >/dev/null
grep -qx 'Hidden=true' "$entry" || fail "Hidden=true not added"

mkdir -p "$home/.local/state/jackstay"
touch "$home/.local/state/jackstay/index"
# A hotkey for the popup, beside a binding of the user's own.
printf '/commands/custom/<Alt>F2 xfce4-appfinder\n' >>"$xfconf"
install --hotkey '<Primary><Alt>h' >/dev/null
grep -qxF "/commands/custom/<Primary><Alt>h $home/.local/bin/jackstay popup" "$xfconf" \
  || fail "hotkey not bound: $(cat "$xfconf")"

install --uninstall >/dev/null
! grep -qF 'jackstay popup' "$xfconf" || fail "hotkey left bound"
grep -qxF '/commands/custom/<Alt>F2 xfce4-appfinder' "$xfconf" || fail "the user's binding removed"
for f in .local/bin/jackstayd .local/bin/jackstay .local/bin/jackstay-ui \
  .local/bin/jackstay-session .config/systemd/user/jackstayd.service \
  .config/systemd/user/jackstay-ui.service .config/autostart/jackstay.desktop \
  .local/share/icons/hicolor/scalable/apps/jackstay.svg; do
  [[ ! -e "$home/$f" ]] || fail "$f not removed"
done
[[ -e "$home/.local/state/jackstay/index" ]] || fail "the history was removed"
[[ "$(cat "$home/.xsessionrc")" == 'export LANG=en_CA.UTF-8' ]] \
  || fail ".xsessionrc not put back: $(cat "$home/.xsessionrc")"
# A linked .xsessionrc (dotfiles in a repository) stays a link; the file it names is edited.
mkdir -p "$home/dotfiles"
printf 'export C=3\r\n' >"$home/dotfiles/xsessionrc"
chmod 640 "$home/dotfiles/xsessionrc"
ln -sf dotfiles/xsessionrc "$home/.xsessionrc"
install >/dev/null
install >/dev/null
[[ -L "$home/.xsessionrc" ]] || fail "the .xsessionrc link was replaced"
[[ "$(stat -c %a "$home/dotfiles/xsessionrc")" == 640 ]] || fail "the linked file's mode changed"
[[ "$(grep -c XFSETTINGSD_NO_CLIPBOARD "$home/dotfiles/xsessionrc")" == 1 ]] \
  || fail "the linked file's switch not set once"
# Saved by an editor with carriage returns, the block is still found.
sed -i 's/$/\r/' "$home/dotfiles/xsessionrc"
install >/dev/null
[[ "$(grep -c XFSETTINGSD_NO_CLIPBOARD "$home/dotfiles/xsessionrc")" == 1 ]] \
  || fail "a block with carriage returns added again"
install --uninstall >/dev/null
[[ -L "$home/.xsessionrc" ]] || fail "uninstall replaced the link"
! grep -q jackstay "$home/dotfiles/xsessionrc" || fail "uninstall left the block in the linked file"
rm "$home/.xsessionrc"
# An empty one of the user's own is left alone.
: >"$home/.xsessionrc"
install --uninstall >/dev/null
[[ -e "$home/.xsessionrc" ]] || fail "the user's empty .xsessionrc removed"
# A block missing its end line is refused, the file untouched.
install >/dev/null
printf 'export A=1\n# jackstay begin: no clipboard manager in xfsettingsd (tools/install)\nexport B=2\n' \
  >"$home/.xsessionrc"
cp "$home/.xsessionrc" "$home/xsessionrc.before"
! install >/dev/null 2>&1 || fail "a block without its end was accepted"
! install --uninstall >/dev/null 2>&1 || fail "uninstall accepted a block without its end"
[[ -e "$home/.local/bin/jackstayd" ]] || fail "a refused uninstall removed something"
cmp -s "$home/.xsessionrc" "$home/xsessionrc.before" || fail "a broken .xsessionrc was changed"
# A .xsessionrc holding only the block goes with it.
rm "$home/.xsessionrc"
install >/dev/null
install --uninstall >/dev/null
[[ ! -e "$home/.xsessionrc" ]] || fail "an .xsessionrc of Jackstay's alone left behind"
printf 'install, reinstall, .xsessionrc, --replace-clipman, --hotkey and --uninstall did what they say\n'
