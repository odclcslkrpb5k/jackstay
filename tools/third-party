#!/usr/bin/env bash
# THIRD-PARTY-NOTICES.md: the licences of every crate built into the release's programs, which a
# release ships beside them (install.sh, tools/publish).
#
#   ./dev tools/third-party           write it
#   ./dev tools/third-party --check   fail if the committed one is not what would be written (gate)
#
# The crates are those linked into jackstayd, jackstay and jackstay-ui on x86_64 Linux: normal
# dependencies, without build scripts' or proc macros' (`cargo tree`), each with the licence,
# notice and copyright files of its package. Identical texts are printed once, with the crates
# that carry them. GTK and the other system libraries are linked dynamically from the system and
# not distributed. Every crate comes from crates.io (the gate's cargo-deny allows no other
# source), so a package's files are in cargo's registry.
set -euo pipefail
IFS=$'\n\t'

cd "$(dirname "$0")/.."
out=THIRD-PARTY-NOTICES.md
check=0
case "${1:-}" in
  --check) check=1 ;;
  "") ;;
  *) printf 'usage: tools/third-party [--check]\n' >&2; exit 2 ;;
esac
if [[ "${JACKSTAY_DEV_CONTAINER:-}" != 1 ]]; then
  printf 'run in the dev container: ./dev tools/third-party\n' >&2
  exit 2
fi

cargo fetch --locked --quiet
registry=$(printf '%s\n' "${CARGO_HOME:?}"/registry/src/index.crates.io-*)
[[ -d "$registry" ]] || { printf 'no crates.io registry at %s\n' "$registry" >&2; exit 1; }

# "name version<TAB>licence", one a crate, sorted; the workspace's own (a path) left out, and the
# blank lines between the three programs' trees.
crates=$(cargo tree --locked -e normal,no-proc-macro --target x86_64-unknown-linux-gnu \
  -p jackstayd -p jackstay -p jackstay-ui --prefix none --format $'{p}\t{l}' \
  | sed -E 's/ \(\*\)$//; s/^([^ ]+) v/\1 /' | grep -v -e ' (/' -e '^$' | LC_ALL=C sort -u)
[[ -n "$crates" ]] || { printf 'cargo tree listed no crates\n' >&2; exit 1; }

texts=$(mktemp -d)
trap 'rm -rf "$texts"' EXIT
notices() {
  cat <<'EOF'
# Third-party notices

Jackstay is GPL-3.0-or-later (LICENSE). Its programs are built with the crates below, under their
own licences. GTK, GLib and the other system libraries are linked dynamically from the system and
are not distributed with them. Generated by `tools/third-party`; the gate checks it is current.

## Crates

| Crate | Version | Licence |
|---|---|---|
EOF
  local line package licence name version dir file sum
  while IFS=$'\t' read -r package licence; do
    name=${package% *}
    version=${package#* }
    printf '| %s | %s | %s |\n' "$name" "$version" "${licence:-unknown}"
    dir=$registry/$name-$version
    [[ -d "$dir" ]] || { printf '%s: not in the registry\n' "$dir" >&2; return 1; }
    local found=0
    while IFS= read -r -d '' file; do
      found=1
      sum=$(sed -e 's/[[:space:]]*$//' "$file" | sha256sum | cut -c1-64)
      [[ -f "$texts/$sum" ]] || sed -e 's/[[:space:]]*$//' "$file" >"$texts/$sum"
      printf '%s %s (%s)\n' "$name" "$version" "${file##*/}" >>"$texts/$sum.users"
    done < <(find "$dir" -maxdepth 1 -type f -regextype posix-extended \
      -iregex '.*/(licen[cs]e|copying|notice|copyright)([-._][^/]*)?' -print0 | LC_ALL=C sort -z)
    if ((!found)); then
      line="(No licence file in the package; its manifest says ${licence:-nothing}.)"
      sum=$(printf '%s' "$line" | sha256sum | cut -c1-64)
      printf '%s\n' "$line" >"$texts/$sum"
      printf '%s %s\n' "$name" "$version" >>"$texts/$sum.users"
    fi
  done <<<"$crates"
  printf '\n## Licence texts\n'
  # Each text once, under the crates that carry it, ordered by the first of them.
  local users
  for users in "$texts"/*.users; do
    printf '%s\t%s\n' "$(head -n1 "$users")" "$users"
  done | LC_ALL=C sort | while IFS=$'\t' read -r _ users; do
    printf '\n### %s\n\n```text\n' "$(paste -sd ',' "$users" | sed 's/,/, /g')"
    # Leading and trailing blank lines dropped.
    sed -e '/./,$!d' "${users%.users}" | sed -e ':a' -e '/^\n*$/{$d;N;ba' -e '}'
    printf '```\n'
  done
}

generated=$(notices)
if ((check)); then
  if [[ ! -f "$out" ]] || [[ "$(cat "$out")" != "$generated" ]]; then
    printf '%s is out of date: run ./dev tools/third-party\n' "$out" >&2
    exit 1
  fi
  printf '%s is current (%s crates)\n' "$out" "$(wc -l <<<"$crates")"
  exit 0
fi
printf '%s\n' "$generated" >"$out"
printf 'wrote %s (%s crates, %s KiB)\n' "$out" "$(wc -l <<<"$crates")" "$(( $(wc -c <"$out") / 1024 ))"
