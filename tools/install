#!/usr/bin/env bash
# Installs this checkout for this user (README, "Building from source"): builds in the dev
# container, stages the programs and data files as a release lays them out, and installs them with
# install.sh, the piped installer, so a build and a release are installed by the same code. Takes
# install.sh's options (tools/install --help).
set -euo pipefail
IFS=$'\n\t'

cd "$(dirname "$0")/.."
tree=$PWD

from=""
args=()
uninstall=0
while (($#)); do
  case "$1" in
    # Install already-built binaries from DIR instead of building (for testing this script).
    --from) from=${2:?--from needs a directory}; shift ;;
    --uninstall) uninstall=1; args+=("$1") ;;
    -h | --help) bash install.sh --help; exit 0 ;;
    *) args+=("$1") ;;
  esac
  shift
done
if ((uninstall)); then
  exec bash install.sh "${args[@]}"
fi

if [[ -z "$from" ]]; then
  ./dev env CARGO_TARGET_DIR=/work/.cache/target \
    cargo build --release --locked -p jackstayd -p jackstay -p jackstay-ui
  from=$tree/.cache/target/release
fi
staged=$(mktemp -d)
trap 'rm -rf "$staged"' EXIT
for p in jackstayd jackstay jackstay-ui; do
  [[ -x "$from/$p" ]] || { printf '%s/%s: not built\n' "$from" "$p" >&2; exit 1; }
  cp "$from/$p" "$staged/"
done
cp data/jackstay-session data/systemd/jackstayd.service data/systemd/jackstay-ui.service \
  data/autostart/jackstay.desktop data/icons/jackstay.svg data/icons/jackstay-symbolic.svg \
  "$staged/"
GBK_FROM=$staged bash install.sh "${args[@]}"
