#!/bin/sh
# Starts jackstayd and jackstay-ui for this graphical session (run from XDG autostart).
# xfce4-session already exports DISPLAY and XAUTHORITY to the systemd user manager; importing them
# again is harmless.
set -eu
systemctl --user import-environment DISPLAY XAUTHORITY
exec systemctl --user start jackstayd.service jackstay-ui.service
